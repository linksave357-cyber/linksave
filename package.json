    "svelte": "^5.56.8",
    "vite": "^6.2.0"
  },
  "dependencies": {
    "@lucide/svelte": "^1.33.0",
    "@tailwindcss/vite": "^4.3.3",
    "lucide-svelte": "^1.0.1",
    "tailwindcss": "^4.3.3"
  }
}
